## Database
# Primary Postgres connection string used by the app (Neon recommended)
POSTGRES_URL=

# Some tools/libraries also read DATABASE_URL
# If your tooling relies on DATABASE_URL, keep it in sync with POSTGRES_URL
DATABASE_URL=POSTGRES_URL

## Auth (NextAuth.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
# For production deployments, also set NEXTAUTH_URL to your site origin
# NEXTAUTH_URL=https://your-domain.com
